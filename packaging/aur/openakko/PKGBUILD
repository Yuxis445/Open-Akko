# Maintainer: João Victor Freitas <luffy2033@outlook.com>
pkgname=openakko
pkgver=0.2.1
pkgrel=1
pkgdesc='Native, offline configurator for Akko keyboards (YC3121/YC500 family)'
arch=('x86_64' 'aarch64')
url='https://github.com/Yuxis445/Open-Akko'
license=('MIT')
depends=('gcc-libs' 'glibc' 'libxkbcommon' 'libglvnd' 'hicolor-icon-theme')
optdepends=('wayland: Wayland session support' 'libx11: X11 session support')
makedepends=('cargo')
conflicts=('openakko-bin')
options=('!lto')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('592d1ff19ba63f1d0315f39b93fbab773626491f8247fba09ec44be26c70c2c6')

prepare() {
  cd "Open-Akko-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "Open-Akko-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  export RUSTFLAGS="${RUSTFLAGS:-} --remap-path-prefix=$srcdir=/build"
  cargo build --frozen --release
}

check() {
  cd "Open-Akko-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo test --frozen --release
}

package() {
  cd "Open-Akko-$pkgver"
  install -Dm755 target/release/openakko -t "$pkgdir/usr/bin/"
  install -Dm644 70-akko.rules -t "$pkgdir/usr/lib/udev/rules.d/"
  install -Dm644 packaging/openakko.desktop -t "$pkgdir/usr/share/applications/"
  install -Dm644 packaging/openakko.svg -t "$pkgdir/usr/share/icons/hicolor/scalable/apps/"
  install -Dm644 packaging/openakko-256.png "$pkgdir/usr/share/icons/hicolor/256x256/apps/openakko.png"
  install -Dm644 packaging/io.github.yuxis445.OpenAkko.metainfo.xml -t "$pkgdir/usr/share/metainfo/"
  install -Dm644 README.md -t "$pkgdir/usr/share/doc/$pkgname/"
  install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname/"
}
