# Maintainer: João Victor Freitas <luffy2033@outlook.com>
pkgname=openakko-bin
_pkgname=openakko
pkgver=0.2.1
pkgrel=1
pkgdesc='Native, offline configurator for Akko keyboards (YC3121/YC500 family) - prebuilt binary'
arch=('x86_64')
url='https://github.com/Yuxis445/Open-Akko'
license=('MIT')
depends=('gcc-libs' 'glibc' 'libxkbcommon' 'libglvnd' 'hicolor-icon-theme')
optdepends=('wayland: Wayland session support' 'libx11: X11 session support')
provides=("$_pkgname")
conflicts=("$_pkgname")
source=("$url/releases/download/v$pkgver/$_pkgname-v$pkgver-x86_64-linux.tar.gz")
sha256sums=('SKIP')

package() {
  cd "$_pkgname-v$pkgver-x86_64-linux"
  install -Dm755 openakko -t "$pkgdir/usr/bin/"
  install -Dm644 70-akko.rules -t "$pkgdir/usr/lib/udev/rules.d/"
  install -Dm644 openakko.desktop -t "$pkgdir/usr/share/applications/"
  install -Dm644 openakko.svg -t "$pkgdir/usr/share/icons/hicolor/scalable/apps/"
  install -Dm644 openakko-256.png "$pkgdir/usr/share/icons/hicolor/256x256/apps/openakko.png"
  install -Dm644 io.github.yuxis445.OpenAkko.metainfo.xml -t "$pkgdir/usr/share/metainfo/"
  install -Dm644 README.md -t "$pkgdir/usr/share/doc/$_pkgname/"
  install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/$_pkgname/"
}
